# Stripe publishable key (client-side, inlined at build time by Vite).
# Set this in Vercel: Project Settings -> Environment Variables (Production/Preview/Development).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Backend API base URL (see auth_company_product.md for the full contract).
VITE_API_BASE_URL=http://localhost:5000/api/v1
